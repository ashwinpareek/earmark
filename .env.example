# ─── PayPal (sandbox) ───────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the same app page (enables signature verification)
PAYPAL_WEBHOOK_ID=
# "sandbox" (default when keys are set) or "mock" (offline dev, no PayPal calls)
PAYPAL_MODE=sandbox

# Where hospital payouts go. Use a sandbox BUSINESS account email you own
# (developer.paypal.com → Testing Tools → Sandbox Accounts) so you can see the money arrive.
PROVIDER_PAYPAL_EMAIL=

# ─── AI (set ONE; priority Anthropic → OpenAI → Gemini) ─────────────
# Must support images. Gemini's free tier works: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o-mini

# ─── AG Studio (optional) ───────────────────────────────────────────
# Without a key the ledger shows a watermark (the AG Grid team said it won't be penalised).
AG_STUDIO_LICENSE=

# ─── Optional ───────────────────────────────────────────────────────
# Public base URL for PayPal return URLs. Render sets RENDER_EXTERNAL_URL automatically.
APP_BASE_URL=http://localhost:3000
