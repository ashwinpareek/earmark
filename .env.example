# ─── PayPal (sandbox) ───────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the same app page (enables signature verification)
PAYPAL_WEBHOOK_ID=
# "sandbox" (default when keys are set) or "mock" (offline dev, no PayPal calls)
PAYPAL_MODE=sandbox
# Sandbox only: any other value stops the app from starting.
PAYPAL_ENVIRONMENT=sandbox

# Where provider payouts go. Use a sandbox BUSINESS account email you own
# (developer.paypal.com → Testing Tools → Sandbox Accounts) so you can see the money arrive.
PROVIDER_PAYPAL_EMAIL=
# Optional: a separate sandbox Business account for the demo pharmacy
PHARMACY_PAYPAL_EMAIL=
# "payout" (default): capture each donor's share and pay providers via Payouts in one step.
# "direct": the hospital is the PayPal payee on every hold, so money never touches the platform
#           (needs PayPal multiparty / third-party payee permissions on your app).
PAYEE_MODE=payout

# ─── AI (set ONE; priority Anthropic → OpenAI → Gemini) ─────────────
# Must support images. Gemini's free tier works: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o-mini

# ─── AG Studio (optional) ───────────────────────────────────────────
# Without a key the ledger shows a watermark (the AG Grid team said it won't be penalised).
AG_STUDIO_LICENSE=

# ─── Optional ───────────────────────────────────────────────────────
# Public base URL for PayPal return URLs. Render sets RENDER_EXTERNAL_URL automatically.
APP_BASE_URL=http://localhost:3000

# Optional: Postgres persistence (set automatically by render.yaml)
DATABASE_URL=
# Shared secret for the daily hold-monitor cron (set automatically by render.yaml)
CRON_SECRET=
